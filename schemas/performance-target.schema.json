{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NeverMorewd/DotNetPerformanceDashboard/schemas/performance-target.schema.json",
  "title": ".NET Performance Dashboard target",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "platforms", "publish", "measurement", "schedule"],
  "properties": {
    "$schema": { "type": "string" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "projectPath", "reportLabel"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "ref": { "type": "string", "minLength": 1 },
        "projectPath": { "type": "string", "minLength": 1 },
        "reportLabel": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "platforms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "Windows": { "$ref": "#/$defs/platform" },
        "Linux": { "$ref": "#/$defs/platform" },
        "macOS": { "$ref": "#/$defs/platform" }
      }
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dotnetVersion", "configuration", "selfContained", "nativeAot", "trimmed", "lockedRestore"],
      "properties": {
        "dotnetVersion": { "type": "string", "minLength": 1 },
        "configuration": { "type": "string", "minLength": 1 },
        "selfContained": { "type": "boolean" },
        "nativeAot": { "type": "boolean" },
        "trimmed": { "type": "boolean" },
        "lockedRestore": { "type": "boolean" }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmupSeconds", "measurementSeconds", "sampleIntervalMilliseconds", "cooldownSeconds", "iterations", "collectCounters", "counterDurationSeconds", "collectTrace", "traceDurationSeconds", "artifactRetentionDays", "meters"],
      "properties": {
        "warmupSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "measurementSeconds": { "type": "integer", "minimum": 5, "maximum": 86400 },
        "sampleIntervalMilliseconds": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "cooldownSeconds": { "type": "integer", "minimum": 0, "maximum": 600 },
        "iterations": { "type": "integer", "minimum": 1, "maximum": 20 },
        "collectCounters": { "type": "boolean" },
        "counterDurationSeconds": { "type": "integer", "minimum": 5, "maximum": 3600 },
        "collectTrace": { "type": "boolean" },
        "traceDurationSeconds": { "type": "integer", "minimum": 5, "maximum": 3600 },
        "artifactRetentionDays": { "type": "integer", "minimum": 1, "maximum": 90 },
        "meters": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "platforms"],
      "properties": {
        "enabled": { "type": "boolean" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["Windows", "Linux", "macOS"] }
        }
      }
    }
  },
  "$defs": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildRunner", "runtimeIdentifier", "executablePath"],
      "properties": {
        "buildRunner": { "type": "string", "minLength": 1 },
        "runtimeIdentifier": { "type": "string", "minLength": 1 },
        "executablePath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
